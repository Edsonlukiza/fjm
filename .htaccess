# Defense in depth: if the vhost DocumentRoot is ever pointed at the project
# root instead of /public, this blocks direct access to source, storage and
# config. The correct setup is DocumentRoot -> tayo-tech/public.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
